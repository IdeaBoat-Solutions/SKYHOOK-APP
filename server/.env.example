# --- Server ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# --- PostgreSQL ---
# Local dev:  postgres://skyhook_app:skyhook_app@localhost:5432/skyhook
# Supabase (transaction pooler, port 6543) for app queries:
DATABASE_URL=postgres://skyhook_app:CHANGE_ME@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Supabase direct connection (port 5432) for DDL/migrations. Falls back to DATABASE_URL.
# Supabase root CA (public cert) — fixes SELF_SIGNED_CERT_IN_CHAIN. Keep sslmode out of the URLs when set.
DATABASE_SSL_CA=./certs/supabase-ca.crt
DATABASE_URL_DIRECT=postgres://skyhook_app:CHANGE_ME@aws-0-ap-southeast-1.supabase.co:5432/postgres

# --- Supabase Auth + Storage ---
# Leaving these blank runs the local dev stack (scrypt passwords, HS256 tokens, local files).
# Fill all of them to switch the API to Supabase Auth + Supabase Storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional override; derived from SUPABASE_URL when blank.
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=skyhook-documents

# --- Legacy / custom OIDC auth (used only when Supabase is not configured) ---
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=skyhook-api
JWT_JWKS_URL=
JWT_DEV_SECRET=local-development-secret-change-me-please-32b

# --- Optional ---
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=
APP_TIMEZONE=Asia/Kolkata
DEMO_DATE=
STORAGE_DIR=./storage
