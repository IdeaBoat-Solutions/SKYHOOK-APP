{
  "name": "skyhook-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Skyhook ERP backend — modular monolith (Phase 1 foundation)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts",
    "dev-token": "tsx src/scripts/dev-token.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
